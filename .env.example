# Required
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devpassword
# Comma-separated Google accounts allowed to sign in to the admin UI and the MCP server
ADMIN_EMAILS=you@example.com
# Public origin; Google redirects to $BASE_URL/oauth/google/callback
BASE_URL=http://localhost:8080
# Google OAuth web client (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
PORT=8080
RUST_LOG=kent_api=debug,kent_domain=debug,kent_db=debug
STATIC_DIR=./dist
# Local development only: skip Google and sign in as this email (must be in
# ADMIN_EMAILS; refused unless BASE_URL is localhost)
# DEV_LOGIN_EMAIL=you@example.com
